<Window x:Class="TextDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Width="520" Height="620"
        MinWidth="480" MinHeight="400"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0" Background="{DynamicResource BgBrush}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <GroupBox Header="{DynamicResource Settings_Grp_Language}" Foreground="{DynamicResource FgBrush}">
                        <ComboBox x:Name="LanguageCombo" Width="140" HorizontalAlignment="Left" Margin="6">
                            <ComboBoxItem Content="日本語" Tag="ja"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource Settings_Grp_Basic}" Foreground="{DynamicResource FgBrush}" Margin="0,10,0,0">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Settings_Lbl_MemoFolder}"/>
                            <TextBox x:Name="MemoFolderBox" Grid.Row="0" Grid.Column="1"
                                     IsReadOnly="True" Margin="0,2"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Settings_Btn_Browse}" Width="70"
                                    Margin="6,2,0,2" Click="BrowseFolder_Click"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Settings_Lbl_Hotkey}"/>
                            <TextBox x:Name="HotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Settings_Lbl_MaxLines}"/>
                            <TextBox x:Name="MaxLinesBox" Grid.Row="2" Grid.Column="1"
                                     Width="80" HorizontalAlignment="Left" Margin="0,2"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource Settings_Grp_Search}" Foreground="{DynamicResource FgBrush}" Margin="0,10,0,0">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="MemoSearchPartialCheck" Content="{DynamicResource Settings_Chk_MemoPartial}" Margin="0,2,0,0"/>
                            <CheckBox x:Name="LineSearchPartialCheck" Content="{DynamicResource Settings_Chk_LinePartial}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <GroupBox Header="{DynamicResource Settings_Grp_Theme}" Foreground="{DynamicResource FgBrush}">
                        <ComboBox x:Name="ThemeCombo" Width="140" HorizontalAlignment="Left" Margin="6"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource Settings_Grp_Font}" Foreground="{DynamicResource FgBrush}" Margin="0,10,0,0">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Settings_Lbl_FontName}"/>
                            <ComboBox x:Name="FontCombo" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Settings_Lbl_FontSize}"/>
                            <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1"
                                     Width="80" HorizontalAlignment="Left" Margin="0,2"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="CustomColorGroup" Header="{DynamicResource Settings_Grp_CustomColor}"
                              Foreground="{DynamicResource FgBrush}" Margin="0,10,0,0">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Settings_Lbl_BgColor}"/>
                            <Button x:Name="BgColorButton" Grid.Row="0" Grid.Column="1" Width="100"
                                    Margin="0,2" Click="ColorButton_Click"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Settings_Lbl_TextColor}"/>
                            <Button x:Name="TextColorButton" Grid.Row="1" Grid.Column="1" Width="100"
                                    Margin="0,2" Click="ColorButton_Click"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Settings_Lbl_SelColor}"/>
                            <Button x:Name="SelColorButton" Grid.Row="2" Grid.Column="1" Width="100"
                                    Margin="0,2" Click="ColorButton_Click"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PasteTab" Header="Paste">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <GroupBox Header="{DynamicResource Settings_Grp_Paste}" Foreground="{DynamicResource FgBrush}">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="{DynamicResource Settings_Lbl_DefaultMethod}" Width="180"/>
                                <ComboBox x:Name="MethodCombo" Width="120">
                                    <ComboBoxItem Content="Clipboard"/>
                                    <ComboBoxItem Content="WM_CHAR"/>
                                    <ComboBoxItem Content="SendInput"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="ProtectCheck" Content="{DynamicResource Settings_Chk_ClipProtect}" Margin="0,6,0,0"/>
                            <CheckBox x:Name="PasteNewlineCheck" Content="{DynamicResource Settings_Chk_PasteNewline}" Margin="0,6,0,0"/>
                            <CheckBox x:Name="PsNewlineCheck" Content="{DynamicResource Settings_Chk_PsNewline}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource Settings_Grp_Timing}" Foreground="{DynamicResource FgBrush}" Margin="0,10,0,0">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Settings_Lbl_ClipDelay}"/>
                            <TextBox x:Name="ClipDelayBox" Grid.Row="0" Grid.Column="1" Width="70" Margin="0,2"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Settings_Lbl_WmDelay}"/>
                            <TextBox x:Name="WmDelayBox" Grid.Row="1" Grid.Column="1" Width="70" Margin="0,2"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Settings_Lbl_SiDelay}"/>
                            <TextBox x:Name="SiDelayBox" Grid.Row="2" Grid.Column="1" Width="70" Margin="0,2"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource Settings_Grp_AppSettings}" Foreground="{DynamicResource FgBrush}" Margin="0,10,0,0">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="AppNameBox" Width="160" Foreground="#DDA006"/>
                                <ComboBox x:Name="AppMethodCombo" Width="110" Margin="6,0,0,0">
                                    <ComboBoxItem Content="SendInput"/>
                                    <ComboBoxItem Content="WM_CHAR"/>
                                    <ComboBoxItem Content="Clipboard"/>
                                </ComboBox>
                                <Button Content="{DynamicResource Settings_Btn_Set}" Width="60" Margin="6,0,0,0" Click="AddAppSetting_Click"/>
                                <Button Content="{DynamicResource Settings_Btn_Remove}" Width="60" Margin="6,0,0,0" Click="RemoveAppSetting_Click"/>
                            </StackPanel>
                            <ListBox x:Name="AppSettingsList" MinHeight="120" Margin="0,6,0,0"
                                     Background="{DynamicResource BgBrush}"
                                     Foreground="{DynamicResource FgBrush}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource Settings_Btn_OK}" Width="80" Click="Ok_Click"/>
            <Button Content="{DynamicResource Settings_Btn_Cancel}" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
